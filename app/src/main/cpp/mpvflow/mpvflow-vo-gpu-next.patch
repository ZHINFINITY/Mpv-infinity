+static bool flow_capture_start_for_pair(struct vo *vo,
+                                        const struct pl_frame *image0,
+                                        const struct pl_frame *image1,
+                                        const struct frame_priv *fp0,
+                                        const struct frame_priv *fp1)
+{
+    struct priv *p = vo->priv;
+    if (!p->flow_capture_pending || !p->flow_gpu || !image0 || !image1 || !fp0 || !fp1)
+        return false;
+    const struct pl_color_space *c0 = &image0->color;
+    const struct pl_color_space *c1 = &image1->color;
+    const bool known_sdr = c0->primaries != PL_COLOR_PRIM_UNKNOWN &&
+        c1->primaries != PL_COLOR_PRIM_UNKNOWN &&
+        c0->transfer != PL_COLOR_TRC_UNKNOWN && c1->transfer != PL_COLOR_TRC_UNKNOWN &&
+        !pl_color_transfer_is_hdr(c0->transfer) && !pl_color_transfer_is_hdr(c1->transfer) &&
+        !pl_color_space_is_hdr(c0) && !pl_color_space_is_hdr(c1) &&
+        !fp0->flow_linear_hdr_source && !fp1->flow_linear_hdr_source;
+    const char *backend = mpvflow_gpu_get_compute_api_name(p->flow_gpu);
+    char settings[1024];
+    if (p->flow_capture_paired) {
+        snprintf(settings, sizeof(settings),
+                 "{\"target_fps\":%d,\"quality\":%d,\"analysis_cap_px\":%d,"
+                 "\"synthesis_cap_px\":%d,\"compute_api_requested\":%d,"
+                 "\"compute_api_resolved\":\"%s\",\"visibility_resolver\":false,"
+                 "\"preserve_motion_blend_on_conflict\":%s,"
+                 "\"comparison_visibility_resolver_override\":true,"
+                 "\"source_dimensions\":[%d,%d],\"processing_dimensions\":[%d,%d],"
+                 "\"color_primaries\":\"%s\",\"color_transfer\":\"%s\"}",
+                 p->next_opts->mpvflow_target_fps, p->next_opts->mpvflow_quality,
+                 p->flow_max_dimension, p->flow_synthesis_max_dimension,
+                 p->next_opts->mpvflow_compute_api, backend ? backend : "unknown",
+                 p->next_opts->mpvflow_soft_blend ? "true" : "false",
+                 fp0->flow_source_w, fp0->flow_source_h, fp0->flow_w, fp0->flow_h,
+                 pl_color_primaries_name(c0->primaries), pl_color_transfer_name(c0->transfer));
+    } else {
+        snprintf(settings, sizeof(settings),
+             "{\"target_fps\":%d,\"quality\":%d,\"analysis_cap_px\":%d,"
+             "\"synthesis_cap_px\":%d,\"compute_api_requested\":%d,"
+             "\"compute_api_resolved\":\"%s\",\"visibility_resolver\":%s,"
+             "\"soft_blend\":%s,\"preserve_motion_blend_on_conflict\":%s,"
+             "\"source_dimensions\":[%d,%d],\"processing_dimensions\":[%d,%d],"
+             "\"color_primaries\":\"%s\",\"color_transfer\":\"%s\"}",
+             p->next_opts->mpvflow_target_fps, p->next_opts->mpvflow_quality,
+             p->flow_max_dimension, p->flow_synthesis_max_dimension,
+             p->next_opts->mpvflow_compute_api, backend ? backend : "unknown",
+             p->next_opts->mpvflow_visibility_resolver ? "true" : "false",
+             p->next_opts->mpvflow_soft_blend ? "true" : "false",
+             p->next_opts->mpvflow_soft_blend ? "true" : "false",
+             fp0->flow_source_w, fp0->flow_source_h, fp0->flow_w, fp0->flow_h,
+             pl_color_primaries_name(c0->primaries), pl_color_transfer_name(c0->transfer));
+    }
+    if (!known_sdr) {
+        flow_capture_terminal(p, p->flow_capture_base_dir,
+            p->flow_capture_session_id, backend,
+            "hdr_dolby_vision_or_unknown_color_refused");
+        p->flow_capture_pending = false;
+        MP_WARN(vo, "MPVFLOW_DIAGNOSTIC component=capture event=start state=refused reason=hdr_dolby_vision_or_unknown_color\n");
+        return false;
+    }
+    const enum MPVFlowGPUResult result = mpvflow_gpu_capture_start(
+        p->flow_gpu, p->flow_capture_base_dir, p->flow_capture_session_id,
+        "mpv", settings, p->flow_capture_paired);
+    p->flow_capture_pending = false;
+    if (result != MPVFLOW_GPU_OK)
+        MP_WARN(vo, "MPVFLOW_DIAGNOSTIC component=capture event=start state=failed status=%d\n", result);
+    return result == MPVFLOW_GPU_OK;
+}
+struct flow_prepared_frame {
+    int nearest;
+    int before;
+    pl_tex output;
+    const char *bypass_reason;
+    int bypass_status;
+    bool prepared;
+};
+
+static void flow_prepare_frame(struct vo *vo, const struct pl_frame_mix *mix,
+                               struct flow_prepared_frame *prepared, bool source_is_still,
+                               bool allow_synthesis, double output_pts)
+{
+    struct priv *p = vo->priv;
+    *prepared = (struct flow_prepared_frame) {
+        .nearest = -1,
+        .before = -1,
+        .bypass_reason = p->flow_gpu ? "no_temporal_pair" : "gpu_context_unavailable",
+        .bypass_status = MPVFLOW_GPU_OK,
+    };
+    flow_update_context(vo);
+    flow_capture_poll_control(vo);
+    prepared->prepared = true;
+    prepared->bypass_reason = p->flow_gpu ? "no_temporal_pair" : "gpu_context_unavailable";
+
+    int before = -1;
+    int after = -1;
+    float nearest_distance = INFINITY;
+    for (int i = 0; i < mix->num_frames; i++) {
+        float ts = mix->timestamps ? mix->timestamps[i] : (i ? 1.0f : 0.0f);
+        float distance = fabsf(ts);
+        if (distance < nearest_distance) {
+            prepared->nearest = i;
+            nearest_distance = distance;
+        }
+        if (ts < 0.0f)
+            before = i;
+        else if (ts > 0.0f && after < 0) {
+            after = i;
+            break;
+        }
+    }
+
+    if (p->paused || source_is_still) {
+        prepared->bypass_reason = p->paused ? "paused" : "still_frame";
+        return;
+    }
+
+    if (p->flow_gpu && mix->timestamps && before >= 0 && after >= 0 && before != after) {
+        float t0 = mix->timestamps[before];
+        float t1 = mix->timestamps[after];
+        float t = -t0 / (t1 - t0);
+        struct pl_frame *image0 = (struct pl_frame *) mix->frames[before];
+        struct pl_frame *image1 = (struct pl_frame *) mix->frames[after];
+        struct mp_image *mpi0 = image0->user_data;
+        struct mp_image *mpi1 = image1->user_data;
+        struct frame_priv *fp0 = mpi0 ? mpi0->priv : NULL;
+        struct frame_priv *fp1 = mpi1 ? mpi1->priv : NULL;
+        float par0 = image0->pixel_aspect_ratio > 0 ? image0->pixel_aspect_ratio : 1.0f;
+        float par1 = image1->pixel_aspect_ratio > 0 ? image1->pixel_aspect_ratio : 1.0f;
+        bool metadata_compatible = pl_color_space_equal(&image0->color, &image1->color) &&
+            fabsf(par0 - par1) < 0.0001f;
+        if (!metadata_compatible) {
+            prepared->bypass_reason = "incompatible_pair_metadata";
+            MP_DBG(vo, "MPVFLOW_DIAGNOSTIC component=gpu event=bypass reason=incompatible_pair_metadata\n");
+        } else if (!fp0 || !fp1) {
+            prepared->bypass_reason = "frame_metadata_unavailable";
+        } else if (!fp0->flow_input || !fp1->flow_input ||
+                   !fp0->flow_source || !fp1->flow_source) {
+            prepared->bypass_reason = "input_unavailable";
+        } else if (fp0->flow_cap != p->flow_max_dimension ||
+                   fp1->flow_cap != p->flow_max_dimension ||
+                   fp0->flow_w != fp1->flow_w || fp0->flow_h != fp1->flow_h ||
+                   fp0->flow_source_w != fp1->flow_source_w || fp0->flow_source_h != fp1->flow_source_h ||
+                   fp0->flow_synthesis_w != fp1->flow_synthesis_w ||
+                   fp0->flow_synthesis_h != fp1->flow_synthesis_h) {
+            prepared->bypass_reason = "incompatible_input_dimensions";
+        }
