+static void flow_log_passthrough(struct vo *vo, const char *reason, int status)
+{
+    struct priv *p = vo->priv;
+    unsigned int reason_class =
+        !strcmp(reason, "no_temporal_pair") ? 1u :
+        !strcmp(reason, "gpu_context_unavailable") ? 2u :
+        !strcmp(reason, "no_source_frame") ? 4u : 8u;
+    if (p->flow_bypass_logged_mask & reason_class)
+        return;
+    p->flow_bypass_logged_mask |= reason_class;
+    const char *backend = p->flow_gpu ? mpvflow_gpu_get_compute_api_name(p->flow_gpu) :
+        (p->gpu ? (p->gpu->glsl.vulkan ? "vulkan" : "non_vulkan") : "unavailable");
+    MP_INFO(vo, "MPVFLOW_DIAGNOSTIC event=output state=passthrough renderer_api=vulkan compute_api=%s "
+            "target_fps=%d reason=%s status=%d cpu_fallback=no\n",
+            backend, p->next_opts->mpvflow_target_fps, reason, status);
+}
