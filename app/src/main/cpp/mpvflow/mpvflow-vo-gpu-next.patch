+        const bool temporal_identity_valid = fp0 && fp1 &&
+            t > 0.0f && t < 1.0f &&
+            mpvflow_synthesis_timestamp_ns(fp0->pts, &source_pts0_ns) &&
+            mpvflow_synthesis_timestamp_ns(fp1->pts, &source_pts1_ns) &&
+            mpvflow_synthesis_timestamp_ns(output_pts, &output_pts_ns);
+        if (!allow_synthesis) {
+            const bool cached_identity = temporal_identity_valid && metadata_compatible &&
+                p->flow_pair &&
+                p->flow_cached_synthesis &&
+                mpvflow_synthesis_identity_matches(
+                    &p->flow_cached_synthesis_identity,
+                    fp0->frame_id, fp1->frame_id,
+                    source_pts0_ns, source_pts1_ns, output_pts_ns,
+                    p->next_opts->mpvflow_target_fps) &&
