+static bool flow_prepare_input(struct vo *vo, struct pl_frame *frame,
+                               struct mp_image *mpi, struct frame_priv *fp)
+{
+    struct priv *p = vo->priv;
+    const struct gl_video_opts *opts = p->opts_cache->opts;
+    const bool hdr_input = pl_color_transfer_is_hdr(frame->color.transfer);
+    const bool high_precision_input = hdr_input || frame->repr.bits.color_depth > 8;
+    if (!p->next_opts->mpvflow || !p->flow_gpu || !p->flow_input_fmt)
+        return false;
+    if (fp->flow_input && fp->flow_source && fp->flow_cap == p->flow_max_dimension &&
+        fp->flow_synthesis_cap == p->flow_synthesis_max_dimension &&
+        ((hdr_input && fp->flow_analysis_source) ||
+         (!hdr_input && !fp->flow_analysis_source)))
+        return true;
+    if (fp->flow_source)
+        pl_tex_destroy(p->gpu, &fp->flow_source);
+    if (fp->flow_input)
+        pl_tex_destroy(p->gpu, &fp->flow_input);
+    if (fp->flow_analysis_source)
+        pl_tex_destroy(p->gpu, &fp->flow_analysis_source);
+    fp->flow_w = fp->flow_h = 0;
+    fp->flow_linear_hdr_source = false;
+    fp->flow_cap = 0;
+    fp->flow_synthesis_cap = 0;
+    fp->flow_synthesis_w = fp->flow_synthesis_h = 0;
+
+    const char *reason = NULL;
+    if (frame->rotation != PL_ROTATION_0)
+        reason = "rotated_frame";
+    else if (frame->repr.dovi || frame->enhancement_layer)
+        reason = "dolby_vision_layer";
+    else if (high_precision_input && !p->flow_rgba16f_fmt)
+        reason = "high_precision_rgba16f_synthesis_unavailable";
+    else if (hdr_input && frame->color.primaries == PL_COLOR_PRIM_UNKNOWN)
+        reason = "hdr_unknown_primaries";
+    else if (!hdr_input && frame->color.transfer == PL_COLOR_TRC_UNKNOWN)
+        reason = "unknown_transfer";
+    else if (frame->icc || frame->profile.len)
+        reason = "icc_profile";
+    else if (mpi->film_grain)
+        reason = "film_grain";
+    else if (mpi->fields & MP_IMGFIELD_INTERLACED)
+        reason = "interlaced";
+    else if (opts->blend_subs)
+        reason = "blended_subtitles";
+
+    const int source_w = mpi->w;
+    const int source_h = mpi->h;
+    if (!reason && (source_w < 8 || source_h < 8))
+        reason = "dimensions_below_block_size";
+    if (reason) {
+        MP_DBG(vo, "MPVFLOW_DIAGNOSTIC component=gpu event=bypass reason=%s\n", reason);
+        return false;
+    }
+
+    const struct mpvflow_synthesis_size synthesis_size =
+        mpvflow_synthesis_size_for(source_w, source_h,
+            p->next_opts->mpvflow_synthesis_max_dimension);
+    pl_fmt source_fmt = high_precision_input ? p->flow_rgba16f_fmt : p->flow_input_fmt;
+    pl_tex source_texture = pl_tex_create(p->gpu, pl_tex_params(
+        .w = synthesis_size.width,
+        .h = synthesis_size.height,
+        .d = 0,
+        .format = source_fmt,
+        .sampleable = true,
+        .renderable = true,
+    ));
+    if (!source_texture) {
+        MP_DBG(vo, "MPVFLOW_DIAGNOSTIC component=gpu event=bypass reason=synthesis_source_allocation "
+               "source=%dx%d synthesis=%dx%d format=%s\n", source_w, source_h,
+               synthesis_size.width, synthesis_size.height,
+               source_fmt ? source_fmt->name : "missing");
+        return false;
+    }
+
+    struct pl_color_space source_color = frame->color;
+    if (hdr_input)
+        source_color.transfer = PL_COLOR_TRC_LINEAR;
+    struct pl_frame source_target = {
+        .repr = pl_color_repr_rgb,
+        .color = source_color,
+        .pixel_aspect_ratio = frame->pixel_aspect_ratio,
+        .num_planes = 1,
+        .planes[0] = {
+            .texture = source_texture,
+            .components = 4,
+            .component_mapping = {0, 1, 2, 3},
+        },
+    };
+    // Keep timed overlays out of motion/color sources; composite them once after synthesis.
+    struct pl_frame source_frame = *frame;
+    source_frame.overlays = NULL;
+    source_frame.num_overlays = 0;
+    // Exclude decoder padding/cropped edges from both motion analysis and synthesis.
+    apply_source_crop(&source_frame, p->src, vo->params->w, vo->params->h, fp);
+    struct pl_render_params source_copy_params = pl_render_default_params;
+    source_copy_params.upscaler = &pl_filter_bilinear;
+    source_copy_params.downscaler = &pl_filter_bilinear;
+    stats_time_start(p->stats, "mpvflow-source-copy");
+    bool ok = pl_render_image(p->rr, &source_frame, &source_target, &source_copy_params);
+    stats_time_end(p->stats, "mpvflow-source-copy");
+    if (!ok) {
+        pl_tex_destroy(p->gpu, &source_texture);
+        MP_DBG(vo, "MPVFLOW_DIAGNOSTIC component=gpu event=bypass reason=full_resolution_source_render\n");
+        return false;
+    }
+
+    pl_tex analysis_texture = NULL;
+    pl_tex analysis_source = source_texture;
+    int analysis_w = source_w, analysis_h = source_h;
+    if (hdr_input) {
+        const int largest_source_dim = source_w > source_h ? source_w : source_h;
+        const double analysis_scale = fmin(1.0,
+            (double) p->flow_max_dimension / (double) largest_source_dim);
+        analysis_w = (int) lround(source_w * analysis_scale);
+        analysis_h = (int) lround(source_h * analysis_scale);
+        if (analysis_w < 8 || analysis_h < 8) {
+            pl_tex_destroy(p->gpu, &source_texture);
+            MP_DBG(vo, "MPVFLOW_DIAGNOSTIC component=gpu event=bypass reason=hdr_analysis_dimensions\n");
+            return false;
+        }
+        analysis_texture = pl_tex_create(p->gpu, pl_tex_params(
+            .w = analysis_w,
+            .h = analysis_h,
+            .d = 0,
+            .format = p->flow_input_fmt,
+            .sampleable = true,
+            .renderable = true,
+        ));
+        if (!analysis_texture) {
+            pl_tex_destroy(p->gpu, &source_texture);
+            MP_DBG(vo, "MPVFLOW_DIAGNOSTIC component=gpu event=bypass reason=hdr_analysis_copy_allocation\n");
+            return false;
+        }
+        struct pl_frame analysis_target = {
+            .repr = pl_color_repr_rgb,
+            .color = {
+                .primaries = PL_COLOR_PRIM_BT_709,
+                .transfer = PL_COLOR_TRC_BT_1886,
+            },
+            .pixel_aspect_ratio = frame->pixel_aspect_ratio,
+            .num_planes = 1,
+            .planes[0] = {
+                .texture = analysis_texture,
+                .components = 4,
+                .component_mapping = {0, 1, 2, 3},
+            },
+        };
+        stats_time_start(p->stats, "mpvflow-hdr-analysis-tonemap");
+        bool analysis_ok = pl_render_image(p->rr, &source_frame, &analysis_target,
+                                           &pl_render_default_params);
+        stats_time_end(p->stats, "mpvflow-hdr-analysis-tonemap");
+        if (!analysis_ok) {
+            pl_tex_destroy(p->gpu, &analysis_texture);
+            pl_tex_destroy(p->gpu, &source_texture);
+            MP_DBG(vo, "MPVFLOW_DIAGNOSTIC component=gpu event=bypass reason=hdr_analysis_tonemap\n");
+            return false;
+        }
+        analysis_source = analysis_texture;
+    }
+
+    pl_tex motion_texture = NULL;
+    enum MPVFlowGPUResult status = mpvflow_gpu_prepare_input(
+        p->flow_gpu, analysis_source, &motion_texture);
+    if (status != MPVFLOW_GPU_OK || !motion_texture) {
+        if (analysis_texture)
+            pl_tex_destroy(p->gpu, &analysis_texture);
+        pl_tex_destroy(p->gpu, &source_texture);
+        MP_DBG(vo, "MPVFLOW_DIAGNOSTIC component=gpu event=bypass reason=motion_analysis_downsample status=%d\n",
+               status);
+        return false;
+    }
+
+    fp->flow_source = source_texture;
+    fp->flow_input = motion_texture;
+    fp->flow_analysis_source = analysis_texture;
+    fp->flow_linear_hdr_source = hdr_input;
+    fp->flow_w = motion_texture->params.w;
+    fp->flow_h = motion_texture->params.h;
+    fp->flow_source_w = source_w;
+    fp->flow_source_h = source_h;
+    fp->flow_cap = p->flow_max_dimension;
+    fp->flow_synthesis_cap = p->flow_synthesis_max_dimension;
+    fp->flow_synthesis_w = synthesis_size.width;
+    fp->flow_synthesis_h = synthesis_size.height;
+    if (hdr_input)
+        MP_DBG(vo, "MPVFLOW_DIAGNOSTIC component=gpu event=hdr_analysis_copy state=ready "
+               "source=rgba16f transfer=%s primaries=%s analysis=bt709_bt1886_tonemapped "
+               "storage=%dx%d motion_cap=%d\n",
+               pl_color_transfer_name(frame->color.transfer),
+               pl_color_primaries_name(frame->color.primaries), analysis_w, analysis_h,
+               p->flow_max_dimension);
+    return true;
+}
