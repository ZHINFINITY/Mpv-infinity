+static void flow_capture_poll_control(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    const char *path = p->next_opts->mpvflow_diagnostic_control_file;
+    if (!path || !path[0])
+        return;
+    const int64_t now = mp_time_ns();
+    if (now <= 0 || now - p->flow_capture_poll_ns < 100000000LL)
+        return;
+    p->flow_capture_poll_ns = now;
+    FILE *file = fopen(path, "r");
+    if (!file)
+        return;
+    char line[PATH_MAX + 128] = {0};
+    const bool read_ok = fgets(line, sizeof(line), file) != NULL;
+    fclose(file);
+    if (!read_ok)
+        return;
+
+    char id[81] = {0};
+    char base_dir[PATH_MAX] = {0};
+    bool paired_output = false;
+    int start_fields = sscanf(line, "START_PAIRED\t%80[A-Za-z0-9_-]\t%4095[^\n]", id, base_dir);
+    if (start_fields == 2)
+        paired_output = true;
+    else
+        start_fields = sscanf(line, "START\t%80[A-Za-z0-9_-]\t%4095[^\n]", id, base_dir);
+    if (start_fields == 2 &&
+        base_dir[0] == '/') {
+        if (!strcmp(id, p->flow_capture_session_id))
+            return;
+        if (p->flow_gpu && mpvflow_gpu_capture_active(p->flow_gpu))
+            mpvflow_gpu_capture_stop(p->flow_gpu);
+        else if (p->flow_capture_pending)
+            flow_capture_terminal(p, p->flow_capture_base_dir,
+                p->flow_capture_session_id, "unknown", "capture_replaced_before_synthesis");
+        snprintf(p->flow_capture_session_id, sizeof(p->flow_capture_session_id), "%s", id);
+        snprintf(p->flow_capture_base_dir, sizeof(p->flow_capture_base_dir), "%s", base_dir);
+        p->flow_capture_paired = paired_output;
+        p->flow_capture_pending = true;
+        if (!p->flow_gpu) {
+            flow_capture_terminal(p, p->flow_capture_base_dir,
+                p->flow_capture_session_id, "unavailable", "mpvflow_context_unavailable");
+            p->flow_capture_pending = false;
+            MP_WARN(vo, "MPVFLOW_DIAGNOSTIC component=capture event=start state=failed reason=mpvflow_context_unavailable\n");
+        }
+        return;
+    }
+    if (sscanf(line, "STOP\t%80[A-Za-z0-9_-]", id) == 1 &&
+        !strcmp(id, p->flow_capture_session_id)) {
+        if (p->flow_gpu && mpvflow_gpu_capture_active(p->flow_gpu))
+            mpvflow_gpu_capture_stop(p->flow_gpu);
+        else if (p->flow_capture_pending)
+            flow_capture_terminal(p, p->flow_capture_base_dir,
+                p->flow_capture_session_id,
+                p->flow_gpu ? mpvflow_gpu_get_compute_api_name(p->flow_gpu) : "unknown",
+                "capture_stopped_before_synthesis");
+        p->flow_capture_pending = false;
+        p->flow_capture_paired = false;
+        p->flow_capture_session_id[0] = '\0';
+    }
+}
