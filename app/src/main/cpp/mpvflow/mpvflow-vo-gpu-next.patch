+                prepared->output = p->flow_cached_synthesis;
+                prepared->bypass_reason = "synthesis_rate_limited_cached";
+            } else {
+                prepared->bypass_reason = "synthesis_rate_limited";
+            }
+            return;
+        }
+
+        if (t > 0.0f && t < 1.0f && fp0 && fp1 && metadata_compatible &&
+            fp0->flow_input && fp1->flow_input &&
+            fp0->flow_source && fp1->flow_source &&
+            fp0->flow_cap == p->flow_max_dimension && fp1->flow_cap == p->flow_max_dimension &&
+            fp0->flow_w == fp1->flow_w && fp0->flow_h == fp1->flow_h &&
+            fp0->flow_source_w == fp1->flow_source_w &&
+            fp0->flow_source_h == fp1->flow_source_h &&
+            fp0->flow_synthesis_w == fp1->flow_synthesis_w &&
+            fp0->flow_synthesis_h == fp1->flow_synthesis_h) {
+            const bool pair_cache_matches = p->flow_pair &&
+                p->flow_pair_ids[0] == fp0->frame_id &&
+                p->flow_pair_ids[1] == fp1->frame_id;
+            // A slow prior present may defer new vector analysis, but must not
+            // discard synthesis from a pair whose vectors are already cached.
+            if (!pair_cache_matches && !mpvflow_previous_present_budget_available(
+                    p->flow_cadence_last_flip_wait_ns,
+                    p->next_opts->mpvflow_target_fps)) {
+                p->flow_cadence_previous_present_budget_skips++;
+                if (p->flow_pair)
+                    flow_release_pair(p);
+                prepared->bypass_reason = "previous_frame_over_budget";
+                return;
+            }
+            if (!pair_cache_matches) {
+                p->flow_cadence_pair_analysis_attempts++;
+                flow_release_pair(p);
+                MPVFlowGPUPair *pair = NULL;
+                stats_time_start(p->stats, "mpvflow-analysis");
+                enum MPVFlowGPUResult status = mpvflow_gpu_analyze_pair(
+                    p->flow_gpu, fp0->flow_input, fp1->flow_input, &pair);
+                stats_time_end(p->stats, "mpvflow-analysis");
+                if (status == MPVFLOW_GPU_OK && pair) {
