+                        p->flow_geometry_h = fp0->flow_h;
+                    }
+                } else {
+                    p->flow_cadence_pair_analysis_failures++;
+                    prepared->bypass_reason = "pair_analysis_failed";
+                    prepared->bypass_status = status;
+                    MP_DBG(vo, "MPVFLOW_DIAGNOSTIC component=gpu event=bypass reason=pair_analysis status=%d\n",
+                           status);
+                }
+            } else {
+                p->flow_cadence_pair_cache_reuses++;
+            }
+
+            if (p->flow_pair) {
+                (void) flow_capture_start_for_pair(vo, image0, image1, fp0, fp1);
+                pl_tex output = NULL;
+                stats_time_start(p->stats, "mpvflow-synthesis");
+                enum MPVFlowGPUResult status;
+                if (mpvflow_gpu_capture_is_paired(p->flow_gpu)) {
+                    status = mpvflow_gpu_capture_paired_sample(
+                        p->flow_gpu, p->flow_pair, fp0->flow_source, fp1->flow_source, t,
+                        fp0->pts, fp1->pts, output_pts,
+                        p->next_opts->mpvflow_soft_blend,
+                        p->next_opts->mpvflow_visibility_resolver,
+                        p->next_opts->mpvflow_soft_blend,
+                        p->next_opts->mpvflow_soft_blend, &output);
+                } else {
+                    status = mpvflow_gpu_synthesize_with_policy(
+                        p->flow_gpu, p->flow_pair, fp0->flow_source, fp1->flow_source, t,
+                        p->next_opts->mpvflow_visibility_resolver,
+                        p->next_opts->mpvflow_soft_blend,
+                        p->next_opts->mpvflow_soft_blend, &output);
+                }
+                stats_time_end(p->stats, "mpvflow-synthesis");
+                if (status == MPVFLOW_GPU_OK && output) {
+                    if (mpvflow_gpu_capture_active(p->flow_gpu) &&
+                        !mpvflow_gpu_capture_is_paired(p->flow_gpu)) {
+                        const enum MPVFlowGPUResult capture_status = mpvflow_gpu_capture_sample(
+                            p->flow_gpu, p->flow_pair, fp0->flow_source, fp1->flow_source,
+                            output, t, fp0->pts, fp1->pts, output_pts,
+                            p->next_opts->mpvflow_visibility_resolver,
+                            p->next_opts->mpvflow_soft_blend,
+                            p->next_opts->mpvflow_soft_blend);
+                        if (capture_status != MPVFLOW_GPU_OK)
+                            MP_WARN(vo, "MPVFLOW_DIAGNOSTIC component=capture event=sample state=failed status=%d\n",
+                                    capture_status);
