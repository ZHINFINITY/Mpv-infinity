+                    p->flow_pair_ids[0] = fp0->frame_id;
+                    p->flow_pair_ids[1] = fp1->frame_id;
+                    if (p->flow_geometry_w != fp0->flow_w || p->flow_geometry_h != fp0->flow_h) {
+                        const int grid_w = (fp0->flow_w - MPVFLOW_GPU_MOTION_FINE_BLOCK_SIZE +
