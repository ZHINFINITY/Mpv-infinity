+                        const int grid_h = (fp0->flow_h - MPVFLOW_GPU_MOTION_FINE_BLOCK_SIZE +
+                            MPVFLOW_GPU_MOTION_GRID_STEP - 1) / MPVFLOW_GPU_MOTION_GRID_STEP + 1;
+                        MP_INFO(vo, "MPVFLOW_DIAGNOSTIC event=motion_geometry state=ready engine=mpv "
