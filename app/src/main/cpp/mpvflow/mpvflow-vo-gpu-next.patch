+            p->flow_init_logged = true;
+        }
+        return;
+    }
+    p->flow_init_attempted = true;
+
+    struct MPVFlowGPUConfig config = {
+        .compute_api = (enum MPVFlowGPUComputeAPI) p->next_opts->mpvflow_compute_api,
+        .diagnostic_engine = "mpv",
+        .max_dimension = effective_dimension,
+        .search_radius = target_fps >= 144 ? (quality >= 75 ? 4 : 3) :
+            target_fps >= 120 ? (quality >= 75 ? 5 : 4) :
+            target_fps >= 96 ? (quality >= 60 ? 6 : 5) : (quality >= 60 ? 8 : 6),
+    };
+    enum MPVFlowGPUResult status = MPVFLOW_GPU_INVALID;
+    struct MPVFlowGPUCreateDiagnostics create_diagnostics = {0};
+    MPVFlowGPUContext *ctx = mpvflow_gpu_create(p->gpu, &config, &status,
+                                                &create_diagnostics);
+    MP_INFO(vo, "MPVFLOW_DIAGNOSTIC event=optical_flow_backend engine=mpv "
+            "state=%s attempted=%d reason=%s qcom2_adapter_ready=%d "
+            "qcom2_luma_pass_ready=%d qcom2_seed_reason=%s\n",
+            create_diagnostics.optical_flow_ready ? "ready" :
+                create_diagnostics.optical_flow_attempted ? "disabled" : "not_attempted",
+            create_diagnostics.optical_flow_attempted,
+            create_diagnostics.optical_flow_reason[0]
+                ? create_diagnostics.optical_flow_reason : "unknown",
+            create_diagnostics.qcom_seed_adapter_ready,
+            create_diagnostics.qcom_seed_luma_pass_ready,
+            create_diagnostics.qcom_seed_reason[0]
+                ? create_diagnostics.qcom_seed_reason : "unknown");
+    pl_fmt input_fmt = pl_find_fmt(p->gpu, PL_FMT_UNORM, 4, 8, 8,
+                                   PL_FMT_CAP_SAMPLEABLE | PL_FMT_CAP_RENDERABLE);
+    pl_fmt rgba16f_fmt = pl_find_named_fmt(p->gpu, "rgba16f");
+    const unsigned int rgba16f_required_caps = PL_FMT_CAP_SAMPLEABLE | PL_FMT_CAP_RENDERABLE |
+        PL_FMT_CAP_STORABLE | PL_FMT_CAP_LINEAR;
+    const bool rgba16f_format_ready = rgba16f_fmt && rgba16f_fmt->glsl_format &&
+        !strcmp(rgba16f_fmt->glsl_format, "rgba16f") &&
+        (rgba16f_fmt->caps & rgba16f_required_caps) == rgba16f_required_caps;
+    if (!ctx || !input_fmt) {
+        mpvflow_gpu_destroy(ctx);
+        const char *backend = p->gpu->glsl.vulkan ? "vulkan" : "non_vulkan";
+        const char *reason = !ctx ? "gpu_compute_initialization_failed" : "input_rgba8_format_unavailable";
+        const char *capability_failure =
+            !p->gpu->glsl.compute ? "glsl_compute" :
+            !p->gpu->glsl.vulkan ? "glsl_vulkan" :
+            p->gpu->glsl.version < 450 ? "glsl_version" :
+            p->gpu->limits.max_pushc_size < 20 ? "max_pushc_size" : "none";
+        unsigned int retry_delay_ms = 0;
+        if (!ctx && requested_compute_api == MPVFLOW_GPU_COMPUTE_OPENCL &&
+            create_diagnostics.stage &&
+            !strcmp(create_diagnostics.stage, "opencl_initialization") &&
+            p->flow_init_retry_count < 2) {
+            const int64_t retry_now_ns = mp_time_ns();
+            if (retry_now_ns > 0) {
+                p->flow_init_retry_count++;
+                retry_delay_ms = p->flow_init_retry_count == 1 ? 5000 : 15000;
+                p->flow_init_retry_after_ns = retry_now_ns +
+                    (int64_t) retry_delay_ms * 1000000LL;
+                p->flow_init_retry_pending = true;
+            }
+        }
+        MP_WARN(vo, "MPVFLOW_DIAGNOSTIC event=renderer_init state=unavailable backend=%s "
+                "target_fps=%d reason=%s status=%d input_rgba8=%d cpu_fallback=no "
+                "capability_failure=%s glsl_compute=%d glsl_vulkan=%d glsl_version=%d "
+                "max_pushc_size=%zu required_pushc_size=%zu max_tex_2d_dim=%u "
+                "max_group_threads=%u max_group_size=%ux%ux%u compute_queues=%u "
+                "create_stage=%s failed_pass_mask=0x%x rgba16f_found=%d rgba16f_caps=0x%x "
+                "rgba8_found=%d rgba8_caps=0x%x input_fmt=%s input_fmt_caps=0x%x "
+                "retry_scheduled=%d retry_count=%u retry_delay_ms=%u\n",
+                backend, p->next_opts->mpvflow_target_fps, reason, status, !!input_fmt,
+                capability_failure, p->gpu->glsl.compute, p->gpu->glsl.vulkan,
+                p->gpu->glsl.version, p->gpu->limits.max_pushc_size,
+                create_diagnostics.required_pushc_size,
+                p->gpu->limits.max_tex_2d_dim, p->gpu->glsl.max_group_threads,
+                p->gpu->glsl.max_group_size[0], p->gpu->glsl.max_group_size[1],
+                p->gpu->glsl.max_group_size[2], p->gpu->limits.compute_queues,
+                create_diagnostics.stage ? create_diagnostics.stage : "unknown",
+                create_diagnostics.failed_pass_mask, create_diagnostics.rgba16f_found,
+                create_diagnostics.rgba16f_caps, create_diagnostics.rgba8_found,
+                create_diagnostics.rgba8_caps, input_fmt && input_fmt->name ? input_fmt->name : "missing",
+                input_fmt ? input_fmt->caps : 0, p->flow_init_retry_pending,
+                p->flow_init_retry_count, retry_delay_ms);
+        p->flow_init_logged = true;
+        return;
+    }
+
+    p->flow_gpu = ctx;
+    p->flow_input_fmt = input_fmt;
+    p->flow_rgba16f_fmt = rgba16f_format_ready &&
+        mpvflow_gpu_rgba16f_synthesis_supported(ctx) ? rgba16f_fmt : NULL;
+    p->flow_init_retry_pending = false;
+    p->flow_init_retry_count = 0;
+    p->flow_init_retry_after_ns = 0;
+    p->flow_init_logged = true;
+    MP_INFO(vo, "MPVFLOW_DIAGNOSTIC event=renderer_init state=initialized backend=%s "
+            "target_fps=%d quality=%d requested_compute_api=%d reason=ready status=0 max_dimension=%d requested_max_dimension=%d search_radius=%d "
+            "rgba16f_synthesis_supported=%d rgba16f_format=%s rgba16f_format_caps=0x%x "
+            "cpu_filter=no synthesized_output_cpu_readback=no\n",
+            mpvflow_gpu_get_compute_api_name(ctx), p->next_opts->mpvflow_target_fps,
+            quality, config.compute_api, config.max_dimension, requested_dimension,
+            config.search_radius, !!p->flow_rgba16f_fmt,
+            p->flow_rgba16f_fmt ? p->flow_rgba16f_fmt->name : "unavailable",
+            rgba16f_fmt ? rgba16f_fmt->caps : 0);
+}
