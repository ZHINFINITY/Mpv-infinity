+static void flow_report_gpu_timing(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    if (!p->flow_gpu)
+        return;
+    const int64_t now_ns = mp_time_ns();
+    if (now_ns <= 0)
+        return;
+    if (!p->flow_timing_last_report_ns) {
+        p->flow_timing_last_report_ns = now_ns;
+        return;
+    }
+    if (now_ns - p->flow_timing_last_report_ns < 1000000000LL)
+        return;
+    p->flow_timing_last_report_ns = now_ns;
+
+    struct MPVFlowGPUTimingStats stats = {0};
+    mpvflow_gpu_get_timing_stats(p->flow_gpu, &stats);
+    static const char *const names[MPVFLOW_GPU_STAGE_COUNT] = {
+        "preprocess", "analysis", "motion_fine", "motion_middle",
+        "motion_coarse", "synthesis",
+    };
+    for (uint32_t i = 0; i < stats.stage_count && i < MPVFLOW_GPU_STAGE_COUNT; i++) {
+        const struct MPVFlowGPUStageTiming *stage = &stats.stages[i];
+        const uint64_t unresolved = stage->dispatches > stage->completed_samples
+            ? stage->dispatches - stage->completed_samples : 0;
+        const double average_us = stage->completed_samples
+            ? (double) stage->total_ns / stage->completed_samples / 1000.0 : 0.0;
+        const char *result_status = !stats.compute_timestamps_supported
+            ? "unsupported_timestamp_capability" :
+            !stage->timer_created ? "unsupported_libplacebo_timer" :
+            !stage->completed_samples ? (stage->dispatches ? "pending_or_dropped" : "awaiting_dispatch") :
+            "ready";
+        MP_INFO(vo, "MPVFLOW_DIAGNOSTIC component=mpvflow event=gpu_timing api=Vulkan "
+                "timer_source=libplacebo_timestamp stage=%s result_status=%s "
+                "timing_scope=libplacebo_vulkan_passes opencl_queue_timing=included_by_host_wait_only "
+                "flow_compute_api=%s "
+                "timestamp_supported=%d compute_queue_family=%u queue_timestamp_valid_bits=%u "
+                "timestamp_period_ns=%.6f timestamp_compute_and_graphics=%d timer_created=%d "
+                "dispatches_total=%llu completed_total=%llu unresolved_dispatches_total=%llu "
+                "average_us=%.2f maximum_us=%.2f sample_scope=lifetime poll=nonblocking\n",
+                names[i], result_status, mpvflow_gpu_get_compute_api_name(p->flow_gpu),
+                stats.compute_timestamps_supported,
+                stats.compute_queue_family, stats.compute_timestamp_valid_bits,
+                stats.timestamp_period_ns, stats.timestamp_compute_and_graphics,
+                stage->timer_created, (unsigned long long) stage->dispatches,
+                (unsigned long long) stage->completed_samples, (unsigned long long) unresolved,
+                average_us, (double) stage->maximum_ns / 1000.0);
+    }
+}
