+static void flow_release_frame(struct vo *vo, struct frame_priv *fp)
+{
+    struct priv *p = vo->priv;
+    flow_release_pair_for_frame(p, fp->frame_id);
+    if (fp->flow_source)
+        pl_tex_destroy(p->gpu, &fp->flow_source);
+    if (fp->flow_input)
+        pl_tex_destroy(p->gpu, &fp->flow_input);
+    fp->flow_w = fp->flow_h = 0;
+    fp->flow_source_w = fp->flow_source_h = 0;
+    fp->flow_cap = 0;
+}
