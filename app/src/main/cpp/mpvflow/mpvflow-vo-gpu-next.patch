+static bool flow_render_source_frame(struct vo *vo, const struct pl_frame *source,
+                                    struct pl_frame *target,
+                                    const struct pl_render_params *params,
+                                    const char *bypass_reason)
+{
+    struct priv *p = vo->priv;
+    struct mp_image *mpi = source->user_data;
+    struct frame_priv *fp = mpi ? mpi->priv : NULL;
+    const bool keep_native_resolution =
+        !strcmp(bypass_reason, "paused") || !strcmp(bypass_reason, "still_frame");
+    if (fp && fp->flow_source && !keep_native_resolution &&
+        (fp->flow_synthesis_w < fp->flow_source_w ||
+         fp->flow_synthesis_h < fp->flow_source_h)) {
+        struct pl_color_space source_color = source->color;
+        if (fp->flow_linear_hdr_source)
+            source_color.transfer = PL_COLOR_TRC_LINEAR;
+        // Match source-frame sharpness to synthesized frames after pre-FRC downscaling.
+        struct pl_frame scaled_source = {
+            .repr = pl_color_repr_rgb,
+            .color = source_color,
+            .num_planes = 1,
+            .planes[0] = {
+                .texture = fp->flow_source,
+                .components = 4,
+                .component_mapping = {0, 1, 2, 3},
+            },
+            .rotation = PL_ROTATION_0,
+            .pixel_aspect_ratio = source->pixel_aspect_ratio,
+            .overlays = source->overlays,
+            .num_overlays = source->num_overlays,
+        };
+        stats_time_start(p->stats, "mpvflow-source-render");
+        bool ok = pl_render_image(p->rr, &scaled_source, target, params);
+        stats_time_end(p->stats, "mpvflow-source-render");
+        if (ok)
+            return true;
+        MP_DBG(vo, "MPVFLOW_DIAGNOSTIC component=gpu event=source_resize_fallback reason=render_failed\n");
+    }
+    return pl_render_image(p->rr, source, target, params);
+}
+
+static bool flow_render_frame(struct vo *vo, const struct pl_frame_mix *mix,
+                              struct pl_frame *target,
+                              const struct pl_render_params *params,
+                              const struct flow_prepared_frame *prepared,
+                              bool *synthesized)
+{
+    struct priv *p = vo->priv;
+    *synthesized = false;
+    if (!prepared->prepared)
+        flow_update_context(vo);
+    const char *bypass_reason = prepared->bypass_reason ? prepared->bypass_reason : "no_temporal_pair";
+    int bypass_status = prepared->bypass_status;
+
+    if (prepared->output && prepared->before >= 0 && prepared->before < mix->num_frames) {
+        struct pl_frame *image0 = (struct pl_frame *) mix->frames[prepared->before];
+        struct mp_image *mpi0 = image0->user_data;
+        struct frame_priv *fp0 = mpi0 ? mpi0->priv : NULL;
+        // The source copy already applies the frame crop; retain only the separate overlays.
+        struct pl_color_space flow_color = image0->color;
+        if (fp0 && fp0->flow_linear_hdr_source)
+            flow_color.transfer = PL_COLOR_TRC_LINEAR;
+        struct pl_frame flow_image = {
+            .repr = pl_color_repr_rgb,
+            .color = flow_color,
+            .num_planes = 1,
+            .planes[0] = {
+                .texture = prepared->output,
+                .components = 4,
+                .component_mapping = {0, 1, 2, 3},
+            },
+            .rotation = PL_ROTATION_0,
+            .pixel_aspect_ratio = image0->pixel_aspect_ratio,
+            .overlays = image0->overlays,
+            .num_overlays = image0->num_overlays,
+        };
+        stats_time_start(p->stats, "mpvflow-render");
+        bool ok = pl_render_image(p->rr, &flow_image, target, params);
+        stats_time_end(p->stats, "mpvflow-render");
+        if (ok) {
+            if (!p->flow_active_logged && fp0) {
+                const pl_tex target_texture = target->num_planes > 0 ? target->planes[0].texture : NULL;
+                const int presentation_width = target_texture ? target_texture->params.w : 0;
+                const int presentation_height = target_texture ? target_texture->params.h : 0;
+                MP_INFO(vo, "MPVFLOW_DIAGNOSTIC event=output state=synthesized renderer_api=vulkan compute_api=%s "
+                        "target_fps=%d reason=motion_pair input_path=%s source=%dx%d motion_analysis=%dx%d "
+                        "synthesis_processing=%dx%d presentation_target=%dx%d video_params=%dx%d "
+                        "motion=yes cpu_filter=no synthesized_output_cpu_readback=no\n",
+                        mpvflow_gpu_get_compute_api_name(p->flow_gpu),
+                        p->next_opts->mpvflow_target_fps,
+                        fp0->hwdec ? "direct-hw-surface" : "software-upload",
+                        fp0->flow_source_w, fp0->flow_source_h,
+                        fp0->flow_w, fp0->flow_h,
+                        fp0->flow_synthesis_w, fp0->flow_synthesis_h,
+                        presentation_width, presentation_height,
+                        vo->params ? vo->params->w : 0,
+                        vo->params ? vo->params->h : 0);
+                p->flow_active_logged = true;
+            }
+            *synthesized = true;
+            return true;
+        }
+        bypass_reason = "synthesized_output_render_failed";
+        MP_DBG(vo, "MPVFLOW_DIAGNOSTIC component=gpu event=bypass reason=synthesized_render\n");
+    }
+
+    // This is a direct source-frame pass-through, not the CPU `vf_mpvflow`
+    // filter and not mpv's temporal blend fallback.
+    MP_DBG(vo, "MPVFLOW_DIAGNOSTIC component=gpu event=bypass reason=no_usable_gpu_pair\n");
+    if (prepared->nearest >= 0 && prepared->nearest < mix->num_frames) {
+        bool ok = flow_render_source_frame(vo, mix->frames[prepared->nearest],
+                                           target, params, bypass_reason);
+        if (ok)
+            flow_log_passthrough(vo, bypass_reason, bypass_status);
+        return ok;
+    }
+    bool ok = pl_render_image(p->rr, NULL, target, params);
+    if (ok)
+        flow_log_passthrough(vo, "no_source_frame", bypass_status);
+    return ok;
+}
