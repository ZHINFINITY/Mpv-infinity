+static bool flow_prepare_input(struct vo *vo, struct pl_frame *frame,
+                               struct mp_image *mpi, struct frame_priv *fp)
+{
+    struct priv *p = vo->priv;
+    const struct gl_video_opts *opts = p->opts_cache->opts;
+    if (!p->next_opts->mpvflow || !p->flow_gpu || !p->flow_input_fmt)
+        return false;
+    if (fp->flow_input && fp->flow_source && fp->flow_cap == p->flow_max_dimension)
+        return true;
+    if (fp->flow_source)
+        pl_tex_destroy(p->gpu, &fp->flow_source);
+    if (fp->flow_input)
+        pl_tex_destroy(p->gpu, &fp->flow_input);
+    fp->flow_w = fp->flow_h = 0;
+    fp->flow_cap = 0;
+
+    const char *reason = NULL;
+    if (frame->rotation != PL_ROTATION_0)
+        reason = "rotated_frame";
+    else if (pl_color_transfer_is_hdr(frame->color.transfer))
+        reason = "hdr";
+    else if (frame->color.transfer == PL_COLOR_TRC_UNKNOWN)
+        reason = "unknown_transfer";
+    else if (frame->repr.dovi || frame->enhancement_layer)
+        reason = "dolby_vision_layer";
+    else if (frame->icc || frame->profile.len)
+        reason = "icc_profile";
+    else if (mpi->film_grain)
+        reason = "film_grain";
+    else if (mpi->fields & MP_IMGFIELD_INTERLACED)
+        reason = "interlaced";
+    else if (opts->blend_subs)
+        reason = "blended_subtitles";
+
+    const int source_w = mpi->w;
+    const int source_h = mpi->h;
+    if (!reason && (source_w < 8 || source_h < 8))
+        reason = "dimensions_below_block_size";
+    if (reason) {
+        MP_DBG(vo, "MPVFLOW_DIAGNOSTIC component=gpu event=bypass reason=%s\n", reason);
+        return false;
+    }
+
+    pl_tex source_texture = pl_tex_create(p->gpu, pl_tex_params(
+        .w = source_w,
+        .h = source_h,
+        .d = 0,
+        .format = p->flow_input_fmt,
+        .sampleable = true,
+        .renderable = true,
+    ));
+    if (!source_texture) {
+        MP_DBG(vo, "MPVFLOW_DIAGNOSTIC component=gpu event=bypass reason=full_resolution_source_allocation\n");
+        return false;
+    }
+
+    struct pl_frame source_target = {
+        .repr = pl_color_repr_rgb,
+        .color = frame->color,
+        .num_planes = 1,
+        .planes[0] = {
+            .texture = source_texture,
+            .components = 4,
+            .component_mapping = {0, 1, 2, 3},
+        },
+    };
+    // Keep timed overlays out of the motion/color sources; composite them once after synthesis.
+    struct pl_frame source_frame = *frame;
+    source_frame.overlays = NULL;
+    source_frame.num_overlays = 0;
+    stats_time_start(p->stats, "mpvflow-source-copy");
+    bool ok = pl_render_image(p->rr, &source_frame, &source_target, NULL);
+    stats_time_end(p->stats, "mpvflow-source-copy");
+    if (!ok) {
+        pl_tex_destroy(p->gpu, &source_texture);
+        MP_DBG(vo, "MPVFLOW_DIAGNOSTIC component=gpu event=bypass reason=full_resolution_source_render\n");
+        return false;
+    }
+
+    pl_tex motion_texture = NULL;
+    enum MPVFlowGPUResult status = mpvflow_gpu_prepare_input(
+        p->flow_gpu, source_texture, &motion_texture);
+    if (status != MPVFLOW_GPU_OK || !motion_texture) {
+        pl_tex_destroy(p->gpu, &source_texture);
+        MP_DBG(vo, "MPVFLOW_DIAGNOSTIC component=gpu event=bypass reason=motion_analysis_downsample status=%d\n",
+               status);
+        return false;
+    }
+
+    fp->flow_source = source_texture;
+    fp->flow_input = motion_texture;
+    fp->flow_w = motion_texture->params.w;
+    fp->flow_h = motion_texture->params.h;
+    fp->flow_source_w = source_w;
+    fp->flow_source_h = source_h;
+    fp->flow_cap = p->flow_max_dimension;
+    return true;
+}
