+static bool flow_render_frame(struct vo *vo, const struct pl_frame_mix *mix,
+                              struct pl_frame *target,
+                              const struct pl_render_params *params,
+                              bool *synthesized)
+{
+    struct priv *p = vo->priv;
+    *synthesized = false;
+    flow_update_context(vo);
+    const char *bypass_reason = p->flow_gpu ? "no_temporal_pair" : "gpu_context_unavailable";
+    int bypass_status = MPVFLOW_GPU_OK;
+
+    int nearest = -1;
+    int before = -1;
+    int after = -1;
+    float nearest_distance = INFINITY;
+    for (int i = 0; i < mix->num_frames; i++) {
+        float ts = mix->timestamps ? mix->timestamps[i] : (i ? 1.0f : 0.0f);
+        float distance = fabsf(ts);
+        if (distance < nearest_distance) {
+            nearest = i;
+            nearest_distance = distance;
+        }
+        if (ts < 0.0f)
+            before = i;
+        else if (ts > 0.0f && after < 0) {
+            after = i;
+            break;
+        }
+    }
+
+    if (p->flow_gpu && mix->timestamps && before >= 0 && after >= 0 && before != after) {
+        float t0 = mix->timestamps[before];
+        float t1 = mix->timestamps[after];
+        float t = -t0 / (t1 - t0);
+        struct pl_frame *image0 = (struct pl_frame *) mix->frames[before];
+        struct pl_frame *image1 = (struct pl_frame *) mix->frames[after];
+        struct mp_image *mpi0 = image0->user_data;
+        struct mp_image *mpi1 = image1->user_data;
+        struct frame_priv *fp0 = mpi0 ? mpi0->priv : NULL;
+        struct frame_priv *fp1 = mpi1 ? mpi1->priv : NULL;
+        float par0 = image0->pixel_aspect_ratio > 0 ? image0->pixel_aspect_ratio : 1.0f;
+        float par1 = image1->pixel_aspect_ratio > 0 ? image1->pixel_aspect_ratio : 1.0f;
+        bool metadata_compatible = pl_color_space_equal(&image0->color, &image1->color) &&
+            fabsf(par0 - par1) < 0.0001f;
+        if (!metadata_compatible) {
+            bypass_reason = "incompatible_pair_metadata";
+            MP_DBG(vo, "MPVFLOW_DIAGNOSTIC component=gpu event=bypass reason=incompatible_pair_metadata\n");
+        } else if (!fp0 || !fp1) {
+            bypass_reason = "frame_metadata_unavailable";
+        } else if (!fp0->flow_input || !fp1->flow_input) {
+            bypass_reason = "input_unavailable";
+        } else if (fp0->flow_w != fp1->flow_w || fp0->flow_h != fp1->flow_h ||
+                   fp0->flow_source_w != fp1->flow_source_w || fp0->flow_source_h != fp1->flow_source_h) {
+            bypass_reason = "incompatible_input_dimensions";
+        }
+
+        if (t > 0.0f && t < 1.0f && fp0 && fp1 && metadata_compatible &&
+            fp0->flow_input && fp1->flow_input &&
+            fp0->flow_w == fp1->flow_w && fp0->flow_h == fp1->flow_h &&
+            fp0->flow_source_w == fp1->flow_source_w &&
+            fp0->flow_source_h == fp1->flow_source_h) {
+            if (!p->flow_pair || p->flow_pair_ids[0] != fp0->frame_id ||
+                p->flow_pair_ids[1] != fp1->frame_id) {
+                flow_release_pair(p);
+                MPVFlowGPUPair *pair = NULL;
+                stats_time_start(p->stats, "mpvflow-analysis");
+                enum MPVFlowGPUResult status = mpvflow_gpu_analyze_pair(
+                    p->flow_gpu, fp0->flow_input, fp1->flow_input, &pair);
+                stats_time_end(p->stats, "mpvflow-analysis");
+                if (status == MPVFLOW_GPU_OK && pair) {
+                    p->flow_pair = pair;
+                    p->flow_pair_ids[0] = fp0->frame_id;
+                    p->flow_pair_ids[1] = fp1->frame_id;
+                } else {
+                    bypass_reason = "pair_analysis_failed";
+                    bypass_status = status;
+                    MP_DBG(vo, "MPVFLOW_DIAGNOSTIC component=gpu event=bypass reason=pair_analysis status=%d\n",
+                           status);
+                }
+            }
+
+            if (p->flow_pair) {
+                pl_tex output = NULL;
+                stats_time_start(p->stats, "mpvflow-synthesis");
+                enum MPVFlowGPUResult status = mpvflow_gpu_synthesize(
+                    p->flow_gpu, p->flow_pair, t, &output);
+                stats_time_end(p->stats, "mpvflow-synthesis");
+                if (status == MPVFLOW_GPU_OK && output) {
+                    struct pl_frame flow_image = {
+                        .repr = pl_color_repr_rgb,
+                        .color = image0->color,
+                        .num_planes = 1,
+                        .planes[0] = {
+                            .texture = output,
+                            .components = 4,
+                            .component_mapping = {0, 1, 2, 3},
+                        },
+                        .crop = {
+                            .x0 = image0->crop.x0 * fp0->flow_w / (float) fp0->flow_source_w,
+                            .y0 = image0->crop.y0 * fp0->flow_h / (float) fp0->flow_source_h,
+                            .x1 = image0->crop.x1 * fp0->flow_w / (float) fp0->flow_source_w,
+                            .y1 = image0->crop.y1 * fp0->flow_h / (float) fp0->flow_source_h,
+                        },
+                        .rotation = PL_ROTATION_0,
+                        .pixel_aspect_ratio = image0->pixel_aspect_ratio,
+                        .overlays = image0->overlays,
+                        .num_overlays = image0->num_overlays,
+                    };
+                    stats_time_start(p->stats, "mpvflow-render");
+                    bool ok = pl_render_image(p->rr, &flow_image, target, params);
+                    stats_time_end(p->stats, "mpvflow-render");
+                    if (ok) {
+                        if (!p->flow_active_logged) {
+                            MP_INFO(vo, "MPVFLOW_DIAGNOSTIC event=output state=synthesized backend=vulkan-spirv "
+                                    "target_fps=%d reason=motion_pair input_path=%s source=%dx%d processing=%dx%d "
+                                    "motion=yes cpu_filter=no synthesized_output_cpu_readback=no\n",
+                                    p->next_opts->mpvflow_target_fps,
+                                    fp0->hwdec ? "direct-hw-surface" : "software-upload",
+                                    fp0->flow_source_w, fp0->flow_source_h,
+                                    fp0->flow_w, fp0->flow_h);
+                            p->flow_active_logged = true;
+                        }
+                        *synthesized = true;
+                        return true;
+                    }
+                    bypass_reason = "synthesized_output_render_failed";
+                    MP_DBG(vo, "MPVFLOW_DIAGNOSTIC component=gpu event=bypass reason=synthesized_render\n");
+                } else {
+                    bypass_reason = output ? "synthesis_failed" : "synthesis_output_missing";
+                    bypass_status = status;
+                }
+                }
+            }
+        }
+
+    // This is a direct source-frame pass-through, not the CPU `vf_mpvflow`
+    // filter and not mpv's temporal blend fallback.
+    MP_DBG(vo, "MPVFLOW_DIAGNOSTIC component=gpu event=bypass reason=no_usable_gpu_pair\n");
+    if (nearest >= 0) {
+        bool ok = pl_render_image(p->rr, mix->frames[nearest], target, params);
+        if (ok)
+            flow_log_passthrough(vo, bypass_reason, bypass_status);
+        return ok;
+    }
+    bool ok = pl_render_image(p->rr, NULL, target, params);
+    if (ok)
+        flow_log_passthrough(vo, "no_source_frame", bypass_status);
+    return ok;
+}
