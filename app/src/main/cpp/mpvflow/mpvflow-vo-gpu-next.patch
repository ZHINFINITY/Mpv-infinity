+static bool flow_prepare_input(struct vo *vo, struct pl_frame *frame,
+                               struct mp_image *mpi, struct frame_priv *fp)
+{
+    struct priv *p = vo->priv;
+    const struct gl_video_opts *opts = p->opts_cache->opts;
+    if (!p->next_opts->mpvflow || !p->flow_gpu || !p->flow_input_fmt ||
+        fp->flow_input)
+        return fp->flow_input != NULL;
+
+    const char *reason = NULL;
+    if (frame->rotation != PL_ROTATION_0)
+        reason = "rotated_frame";
+    else if (pl_color_transfer_is_hdr(frame->color.transfer))
+        reason = "hdr";
+    else if (frame->color.transfer == PL_COLOR_TRC_UNKNOWN)
+        reason = "unknown_transfer";
+    else if (frame->repr.dovi || frame->enhancement_layer)
+        reason = "dolby_vision_layer";
+    else if (frame->icc || frame->profile.len)
+        reason = "icc_profile";
+    else if (mpi->film_grain)
+        reason = "film_grain";
+    else if (mpi->fields & MP_IMGFIELD_INTERLACED)
+        reason = "interlaced";
+    else if (opts->blend_subs)
+        reason = "blended_subtitles";
+
+    int source_w = mpi->w;
+    int source_h = mpi->h;
+    int cap = MPMAX(8, p->next_opts->mpvflow_max_dimension);
+    if (!reason && (source_w < 8 || source_h < 8))
+        reason = "dimensions_below_block_size";
+    if (reason) {
+        MP_DBG(vo, "MPVFLOW_DIAGNOSTIC component=gpu event=bypass reason=%s\n", reason);
+        return false;
+    }
+
+    float scale = MPMIN(1.0f, cap / (float) MPMAX(source_w, source_h));
+    int width = MPMAX(8, (int) (source_w * scale + 0.5f));
+    int height = MPMAX(8, (int) (source_h * scale + 0.5f));
+    pl_tex texture = pl_tex_create(p->gpu, pl_tex_params(
+        .w = width,
+        .h = height,
+        .d = 0,
+        .format = p->flow_input_fmt,
+        .sampleable = true,
+        .renderable = true,
+    ));
+    if (!texture) {
+        MP_DBG(vo, "MPVFLOW_DIAGNOSTIC component=gpu event=bypass reason=input_texture_allocation\n");
+        return false;
+    }
+
+    struct pl_frame target = {
+        .repr = pl_color_repr_rgb,
+        .color = frame->color,
+        .num_planes = 1,
+        .planes[0] = {
+            .texture = texture,
+            .components = 4,
+            .component_mapping = {0, 1, 2, 3},
+        },
+    };
+    stats_time_start(p->stats, "mpvflow-input");
+    bool ok = pl_render_image(p->rr, frame, &target, NULL);
+    stats_time_end(p->stats, "mpvflow-input");
+    if (!ok) {
+        pl_tex_destroy(p->gpu, &texture);
+        MP_DBG(vo, "MPVFLOW_DIAGNOSTIC component=gpu event=bypass reason=input_render\n");
+        return false;
+    }
+
+    fp->flow_input = texture;
+    fp->flow_w = width;
+    fp->flow_h = height;
+    fp->flow_source_w = source_w;
+    fp->flow_source_h = source_h;
+    return true;
+}
+
+static void flow_release_frame(struct vo *vo, struct frame_priv *fp)
+{
+    struct priv *p = vo->priv;
+    flow_release_pair_for_frame(p, fp->frame_id);
+    if (fp->flow_input)
+        pl_tex_destroy(p->gpu, &fp->flow_input);
+    fp->flow_w = fp->flow_h = 0;
+    fp->flow_source_w = fp->flow_source_h = 0;
+}
