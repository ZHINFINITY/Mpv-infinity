+        first->crop.x0 != second->crop.x0 || first->crop.y0 != second->crop.y0 ||
+        first->crop.x1 != second->crop.x1 || first->crop.y1 != second->crop.y1 ||
+        !mp_image_params_equal(&mpi0->params, &mpi1->params))
+        return 0;
