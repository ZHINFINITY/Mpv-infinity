<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_music_player_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_music_player_background"
  android:orientation="vertical"
  android:paddingStart="14dp"
  android:paddingTop="12dp"
  android:paddingEnd="14dp"
  android:paddingBottom="8dp">

  <TextView
    android:id="@+id/widget_track_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:singleLine="true"
    android:textColor="@android:color/white"
    android:textSize="15sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/widget_track_artist"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="2dp"
    android:layout_weight="1"
    android:ellipsize="end"
    android:singleLine="true"
    android:textColor="#B3FFFFFF"
    android:textSize="12sp" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal">

    <ImageButton
      android:id="@+id/widget_button_previous"
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:background="?android:attr/selectableItemBackgroundBorderless"
      android:contentDescription="@string/widget_music_previous"
      android:scaleType="fitCenter"
      android:src="@drawable/materialsymbols_ic_skip_previous_rounded"
      android:tint="#FFFFFF" />

    <ImageButton
      android:id="@+id/widget_button_play_pause"
      android:layout_width="52dp"
      android:layout_height="52dp"
      android:layout_marginStart="18dp"
      android:layout_marginEnd="18dp"
      android:background="?android:attr/selectableItemBackgroundBorderless"
      android:contentDescription="@string/widget_music_play_pause"
      android:scaleType="fitCenter"
      android:src="@drawable/materialsymbols_ic_play_arrow_rounded"
      android:tint="#FFFFFF" />

    <ImageButton
      android:id="@+id/widget_button_next"
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:background="?android:attr/selectableItemBackgroundBorderless"
      android:contentDescription="@string/widget_music_next"
      android:scaleType="fitCenter"
      android:src="@drawable/materialsymbols_ic_skip_next_rounded"
      android:tint="#FFFFFF" />
  </LinearLayout>
</LinearLayout>
