+void *ra_hwdec_aimagereader_get_hardware_buffer(
+    struct ra_hwdec_mapper *mapper, int64_t *timestamp_ns)
+{
+    if (!mapper || !mapper->owner || !mapper->owner->driver ||
+        strcmp(mapper->owner->driver->name, "aimagereader") != 0)
+        return NULL;
+    struct priv *p = mapper->priv;
+    // The returned AHB is borrowed from this exact AImage lease. Callers must
+    // import/acquire it before mapper_unmap deletes p->image.
+    if (!p->image || !p->hardware_buffer)
+        return NULL;
+    if (timestamp_ns)
+        *timestamp_ns = p->timestamp_ns;
+    return p->hardware_buffer;
+}
 
 
