+static void rife_clear_output_ring(struct priv *p)
+{
+    if (p->ra_ctx && p->ra_ctx->ra && p->gpu) {
+        GL *gl = ra_gl_get(p->ra_ctx->ra);
+        if (gl && gl->Finish)
+            gl->Finish();
+    }
+    for (int i = 0; i < MP_ARRAY_SIZE(p->rife_outputs); i++) {
+        struct rife_output_slot *slot = &p->rife_outputs[i];
+        if (slot->wrapped && p->gpu)
+            pl_tex_destroy(p->gpu, &slot->wrapped);
+        if (slot->texture && p->ra_ctx && p->ra_ctx->ra) {
+            GL *gl = ra_gl_get(p->ra_ctx->ra);
+            if (gl)
+                gl->DeleteTextures(1, &slot->texture);
+        }
+        if (slot->image && slot->destroy_image)
+            slot->destroy_image(eglGetCurrentDisplay(), slot->image);
+        rife_vfi_output_destroy(slot->output);
+        *slot = (struct rife_output_slot) {0};
+    }
+    p->rife_output_width = p->rife_output_height = 0;
+    p->rife_output_cursor = 0;
+}
