+static void rife_reset_cadence(struct priv *p)
+{
+    p->rife_cadence_origin_pts = 0.0;
+    p->rife_last_cadence_index = 0;
+    p->rife_cadence_origin_valid = false;
+    p->rife_cadence_output_valid = false;
+    p->rife_last_wait_reason = 0;
+    p->rife_wait_count = 0;
+    p->rife_output_ready_logged = false;
+    p->rife_rendered_logged = false;
+}
+
+enum {
+    RIFE_WAIT_TOO_FEW_FRAMES = 1,
+    RIFE_WAIT_NO_SOURCE_BRACKET,
+    RIFE_WAIT_INPUT_NOT_READY,
+    RIFE_WAIT_CADENCE_MISS,
+    RIFE_WAIT_INVALID_FRACTION,
+    RIFE_WAIT_SOURCE_BOUNDARY,
+    RIFE_WAIT_OUTPUT_RING,
+    RIFE_WAIT_SLOT_SYNC,
+    RIFE_WAIT_ENGINE_NOT_READY,
+    RIFE_WAIT_SESSION_DISABLED,
+    RIFE_WAIT_NO_INTERMEDIATE_TICK,
+};
+
+static const char *rife_wait_reason_name(int reason)
+{
+    switch (reason) {
+    case RIFE_WAIT_TOO_FEW_FRAMES: return "too_few_queue_frames";
+    case RIFE_WAIT_NO_SOURCE_BRACKET: return "source_pair_not_found";
+    case RIFE_WAIT_INPUT_NOT_READY: return "paired_ahb_input_unavailable";
+    case RIFE_WAIT_CADENCE_MISS: return "target_cadence_miss";
+    case RIFE_WAIT_INVALID_FRACTION: return "interpolation_fraction_out_of_range";
+    case RIFE_WAIT_SOURCE_BOUNDARY: return "source_frame_boundary_no_intermediate";
+    case RIFE_WAIT_OUTPUT_RING: return "output_ring_unavailable";
+    case RIFE_WAIT_SLOT_SYNC: return "output_slot_sync_unavailable";
+    case RIFE_WAIT_ENGINE_NOT_READY: return "resident_engine_not_ready";
+    case RIFE_WAIT_SESSION_DISABLED: return "resident_session_disabled_after_error";
+    case RIFE_WAIT_NO_INTERMEDIATE_TICK: return "target_fps_not_above_source_rate";
+    default: return "unknown";
+    }
+}
+
+static void rife_log_wait_reason(struct priv *p, int reason, int mix_frames)
+{
+    if (p->rife_last_wait_reason != reason) {
+        p->rife_last_wait_reason = reason;
+        p->rife_wait_count = 0;
+    }
+    p->rife_wait_count++;
+    if (p->rife_wait_count == 1 || p->rife_wait_count % 120 == 0) {
+        int queue_depth = p->queue ? pl_queue_num_frames(p->queue) : 0;
+        MP_INFO(p, "RIFE_DIAGNOSTIC event=resident_wait reason=%s repeat=%u pts=%.6f mix_frames=%d queue_depth=%d vo_frames=%d display_synced=%d mpv_interpolation=%d can_interpolate=%d paused=%d still=%d pts_offset=%.6f vsync_duration=%.6f pair_before_pts=%.6f pair_after_pts=%.6f before_input_ready=%d after_input_ready=%d timestep=%.6f target_fps=%d cadence_origin_pts=%.6f\n",
+                rife_wait_reason_name(reason), p->rife_wait_count,
+                p->last_pts, mix_frames, queue_depth, p->rife_diag_vo_frames,
+                p->rife_diag_display_synced, p->rife_diag_interpolation_enabled,
+                p->rife_diag_can_interpolate, p->rife_diag_paused,
+                p->rife_diag_still, p->rife_diag_pts_offset,
+                p->rife_diag_vsync_duration, p->rife_diag_pair_before_pts,
+                p->rife_diag_pair_after_pts, p->rife_diag_before_input_ready,
+                p->rife_diag_after_input_ready, p->rife_diag_timestep,
+                p->rife_root_opts ? p->rife_root_opts->rife_target_fps : 0,
+                p->rife_cadence_origin_pts);
+    }
+}
+
+static void rife_sync_engine(struct priv *p)
+{
+    const char *model_dir = p->rife_root_opts->rife_model_dir;
+    bool enabled = p->rife_root_opts->rife_resident && model_dir && model_dir[0];
+    if (!enabled) {
+        if (!p->rife_engine && !p->rife_model_dir &&
+            !p->rife_outputs[0].output && !p->rife_outputs[1].output &&
+            !p->rife_outputs[2].output)
+            return;
+        rife_clear_output_ring(p);
+        rife_vfi_destroy(p->rife_engine);
+        p->rife_engine = NULL;
+        talloc_free(p->rife_model_dir);
+        p->rife_model_dir = NULL;
+        p->rife_disabled_for_session = false;
+        rife_reset_cadence(p);
+        return;
+    }
+    if (p->rife_model_dir && strcmp(p->rife_model_dir, model_dir) == 0 &&
+        (p->rife_engine || p->rife_disabled_for_session))
+        return;
+
+    rife_clear_output_ring(p);
+    rife_vfi_destroy(p->rife_engine);
+    p->rife_engine = NULL;
+    talloc_free(p->rife_model_dir);
+    p->rife_model_dir = talloc_strdup(p, model_dir);
+    rife_reset_cadence(p);
+    char error[256] = {0};
+    p->rife_engine = rife_vfi_create(model_dir, error, sizeof(error));
+    p->rife_disabled_for_session = !p->rife_engine;
+    if (p->rife_engine) {
+        RifeVfiGpuCapabilities capabilities = {0};
+        if (rife_vfi_get_gpu_capabilities(p->rife_engine, &capabilities) != 0 ||
+            !capabilities.vulkan_device_ready ||
+            !capabilities.android_ahb_import_extension ||
+            !capabilities.foreign_queue_family_extension) {
+            MP_WARN(p, "RIFE_DIAGNOSTIC event=resident_error reason=vulkan_ahb_capabilities_unavailable\n");
+            MP_WARN(p, "RIFE resident Vulkan/AHB capabilities are unavailable; preserving ordinary mpv rendering\n");
+            rife_vfi_destroy(p->rife_engine);
+            p->rife_engine = NULL;
+            p->rife_disabled_for_session = true;
+        }
+    }
+    if (!p->rife_engine) {
+        MP_WARN(p, "RIFE_DIAGNOSTIC event=resident_error reason=resident_engine_initialization_failed detail=%s\n",
+                error[0] ? error : "unknown error");
+        MP_WARN(p, "RIFE resident engine unavailable; preserving ordinary playback: %s\n",
+                error[0] ? error : "unknown error");
+    }
+}
+
+static bool rife_init_output_ring(struct priv *p, int width, int height)
+{
+    if (!p->rife_engine || p->rife_disabled_for_session || width <= 0 || height <= 0)
+        return false;
+    if (p->rife_output_width == width && p->rife_output_height == height &&
+        p->rife_outputs[0].wrapped && p->rife_outputs[1].wrapped &&
+        p->rife_outputs[2].wrapped)
+        return true;
+
+    rife_clear_output_ring(p);
+    if (!p->gpu || !p->ra_ctx || !ra_is_gl(p->ra_ctx->ra) ||
+        !pl_opengl_get(p->gpu)) {
+        p->rife_disabled_for_session = true;
+        MP_WARN(p, "RIFE_DIAGNOSTIC event=resident_error reason=output_ring_renderer_unavailable gpu=%d ra_ctx=%d is_gles=%d opengl=%d\n",
+                p->gpu != NULL, p->ra_ctx != NULL,
+                p->ra_ctx && p->ra_ctx->ra && ra_is_gl(p->ra_ctx->ra),
+                p->gpu && pl_opengl_get(p->gpu) != NULL);
+        MP_WARN(p, "RIFE resident presentation requires the existing GLES renderer; preserving ordinary mpv rendering\n");
+        return false;
+    }
+    GL *gl = ra_gl_get(p->ra_ctx->ra);
+    if (!gl) {
+        p->rife_disabled_for_session = true;
+        MP_WARN(p, "RIFE_DIAGNOSTIC event=resident_error reason=output_ring_gles_context_unavailable\n");
+        MP_WARN(p, "RIFE resident GLES context is unavailable; preserving ordinary mpv rendering\n");
+        return false;
+    }
+
+    typedef EGLClientBuffer (EGLAPIENTRY *get_native_buffer_fn)(const AHardwareBuffer *);
+    typedef EGLImageKHR (EGLAPIENTRY *create_image_fn)(EGLDisplay, EGLContext, EGLenum,
+                                                       EGLClientBuffer, const EGLint *);
+    typedef void (GL_APIENTRY *image_target_fn)(GLenum, GLeglImageOES);
+    get_native_buffer_fn get_native_buffer =
+        (get_native_buffer_fn) eglGetProcAddress("eglGetNativeClientBufferANDROID");
+    create_image_fn create_image =
+        (create_image_fn) eglGetProcAddress("eglCreateImageKHR");
+    image_target_fn image_target =
+        (image_target_fn) eglGetProcAddress("glEGLImageTargetTexture2DOES");
+    EGLBoolean (EGLAPIENTRY *destroy_image)(EGLDisplay, EGLImageKHR) =
+        (void *) eglGetProcAddress("eglDestroyImageKHR");
+    EGLDisplay display = eglGetCurrentDisplay();
+    if (!get_native_buffer || !create_image || !image_target || !destroy_image ||
+        display == EGL_NO_DISPLAY) {
+        p->rife_disabled_for_session = true;
+        MP_WARN(p, "RIFE_DIAGNOSTIC event=resident_error reason=output_ring_egl_api_unavailable native_buffer=%d create_image=%d image_target=%d destroy_image=%d display=%d\n",
+                get_native_buffer != NULL, create_image != NULL,
+                image_target != NULL, destroy_image != NULL,
+                display != EGL_NO_DISPLAY);
+        MP_WARN(p, "RIFE resident EGL AHardwareBuffer import is unavailable; preserving ordinary mpv rendering\n");
+        return false;
+    }
+
+    for (int i = 0; i < MP_ARRAY_SIZE(p->rife_outputs); i++) {
+        struct rife_output_slot *slot = &p->rife_outputs[i];
+        char error[256] = {0};
+        slot->output = rife_vfi_output_create(p->rife_engine, width, height,
+                                               error, sizeof(error));
+        if (!slot->output) {
+            MP_WARN(p, "RIFE_DIAGNOSTIC event=resident_error reason=output_ring_native_create_failed slot=%d width=%d height=%d detail=%s\n",
+                    i, width, height,
+                    error[0] ? error : "unsupported format or usage");
+            MP_WARN(p, "RIFE output AHB allocation rejected; preserving ordinary playback: %s\n",
+                    error[0] ? error : "unsupported format or usage");
+            rife_clear_output_ring(p);
+            p->rife_disabled_for_session = true;
+            return false;
+        }
+
+        AHardwareBuffer *buffer = rife_vfi_output_get_ahb(slot->output);
+        EGLClientBuffer client_buffer = buffer ? get_native_buffer(buffer) : NULL;
+        const EGLint image_attributes[] = {EGL_NONE};
+        slot->image = client_buffer
+            ? create_image(display, EGL_NO_CONTEXT, EGL_NATIVE_BUFFER_ANDROID,
+                           client_buffer, image_attributes) : EGL_NO_IMAGE_KHR;
+        slot->destroy_image = destroy_image;
+        if (!slot->image) {
+            EGLint egl_error = buffer ? eglGetError() : EGL_SUCCESS;
+            MP_WARN(p, "RIFE_DIAGNOSTIC event=resident_error reason=output_ring_egl_import_failed slot=%d width=%d height=%d ahb=%d native_client_buffer=%d egl_error=0x%x\n",
+                    i, width, height, buffer != NULL, client_buffer != NULL,
+                    egl_error);
+            MP_WARN(p, "RIFE output AHB EGL import failed; preserving ordinary playback\n");
+            rife_clear_output_ring(p);
+            p->rife_disabled_for_session = true;
+            return false;
+        }
+
+        gl->GenTextures(1, &slot->texture);
+        gl->BindTexture(GL_TEXTURE_2D, slot->texture);
+        gl->TexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        gl->TexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        gl->TexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        gl->TexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        image_target(GL_TEXTURE_2D, (GLeglImageOES) slot->image);
+        gl->BindTexture(GL_TEXTURE_2D, 0);
+
+#ifndef GL_RGBA8
+#define GL_RGBA8 0x8058
+#endif
+        slot->wrapped = pl_opengl_wrap(p->gpu, pl_opengl_wrap_params(
+            .texture = slot->texture,
+            .width = width,
+            .height = height,
+            .target = GL_TEXTURE_2D,
+            .iformat = GL_RGBA8));
+        if (!slot->wrapped) {
+            MP_WARN(p, "RIFE_DIAGNOSTIC event=resident_error reason=output_ring_texture_wrap_failed slot=%d width=%d height=%d texture=%u iformat=0x%x\n",
+                    i, width, height, slot->texture, GL_RGBA8);
+            MP_WARN(p, "RIFE output AHB GLES texture wrapping failed; preserving ordinary playback\n");
+            rife_clear_output_ring(p);
+            p->rife_disabled_for_session = true;
+            return false;
+        }
+    }
+
+    p->rife_output_width = width;
+    p->rife_output_height = height;
+    return true;
+}
+
+static bool rife_prepare_frame_input(struct priv *p, const struct pl_frame *frame)
+{
+    struct mp_image *mpi = frame ? frame->user_data : NULL;
+    struct frame_priv *fp = mpi ? mpi->priv : NULL;
+    if (!fp)
+        return false;
+    if (fp->rife_input)
+        return true;
+    if (fp->rife_input_failed || !frame->acquire || !frame->release)
+        return false;
+
+    // libplacebo normally invokes this lazily while drawing, after the RIFE
+    // pair scheduler has run. Acquire/release each selected frame here so its
+    // AHB is imported before pair readiness is tested. Releasing between calls
+    // is required because gpu-next uses one hardware slot per frame role.
+    struct pl_frame *mutable_frame = (struct pl_frame *) frame;
+    bool acquired = mutable_frame->acquire(p->gpu, mutable_frame);
+    mutable_frame->release(p->gpu, mutable_frame);
+    return acquired && fp->rife_input != NULL;
+}
+
+static bool rife_build_display_mix(struct priv *p, const struct pl_frame_mix *mix,
+                                   struct pl_frame_mix *rife_mix,
+                                   struct pl_frame *rife_frame,
+                                   const struct pl_frame **rife_frames,
+                                   uint64_t *rife_signature,
+                                   float *rife_timestamp, int *slot_index)
+{
+    p->rife_diag_pair_before_pts = NAN;
+    p->rife_diag_pair_after_pts = NAN;
+    p->rife_diag_before_input_ready = false;
+    p->rife_diag_after_input_ready = false;
+    p->rife_diag_timestep = NAN;
+    if (!p->rife_root_opts->rife_resident ||
+        p->rife_root_opts->rife_target_fps < 1)
+        return false;
+    if (p->rife_disabled_for_session) {
+        rife_log_wait_reason(p, RIFE_WAIT_SESSION_DISABLED, mix->num_frames);
+        return false;
+    }
+    if (!p->rife_engine) {
+        rife_log_wait_reason(p, RIFE_WAIT_ENGINE_NOT_READY, mix->num_frames);
+        return false;
+    }
+    if (mix->num_frames < 2) {
+        rife_log_wait_reason(p, RIFE_WAIT_TOO_FEW_FRAMES, mix->num_frames);
+        return false;
+    }
+
+    int before = -1, after = -1;
+    double before_pts = -INFINITY, after_pts = INFINITY;
+    for (int i = 0; i < mix->num_frames; i++) {
+        const struct pl_frame *candidate = mix->frames[i];
+        struct mp_image *mpi = candidate ? candidate->user_data : NULL;
+        if (!mpi || !isfinite(mpi->pts) || mpi->imgfmt != IMGFMT_MEDIACODEC)
+            continue;
+        if (mpi->pts <= p->last_pts && mpi->pts > before_pts) {
+            before = i;
+            before_pts = mpi->pts;
+        } else if (mpi->pts > p->last_pts && mpi->pts < after_pts) {
+            after = i;
+            after_pts = mpi->pts;
+        }
+    }
+    if (before < 0 || after < 0 || after_pts <= before_pts) {
+        rife_log_wait_reason(p, RIFE_WAIT_NO_SOURCE_BRACKET, mix->num_frames);
+        return false;
+    }
+
+    const struct pl_frame *source = mix->frames[before];
+    const struct pl_frame *next = mix->frames[after];
+    struct mp_image *mpi0 = source->user_data;
+    struct mp_image *mpi1 = next->user_data;
+    struct frame_priv *fp0 = mpi0->priv;
+    struct frame_priv *fp1 = mpi1->priv;
+    if (!fp0 || !fp1 || source->enhancement_layer || next->enhancement_layer ||
+        mpi0->params.w != mpi1->params.w || mpi0->params.h != mpi1->params.h) {
+        rife_log_wait_reason(p, RIFE_WAIT_INPUT_NOT_READY, mix->num_frames);
+        return false;
+    }
+    p->rife_diag_pair_before_pts = before_pts;
+    p->rife_diag_pair_after_pts = after_pts;
+    p->rife_diag_before_input_ready = fp0->rife_input ||
+                                       rife_prepare_frame_input(p, source);
+    p->rife_diag_after_input_ready = fp1->rife_input ||
+                                     rife_prepare_frame_input(p, next);
+    if (!p->rife_diag_before_input_ready || !p->rife_diag_after_input_ready) {
+        rife_log_wait_reason(p, RIFE_WAIT_INPUT_NOT_READY, mix->num_frames);
+        return false;
+    }
+
+    double source_duration = after_pts - before_pts;
+    int target_fps = p->rife_root_opts->rife_target_fps;
+    if (source_duration <= 0 || source_duration * target_fps <= 1.0) {
+        rife_log_wait_reason(p, RIFE_WAIT_NO_INTERMEDIATE_TICK, mix->num_frames);
+        return false;
+    }
+    if (!p->rife_cadence_origin_valid) {
+        if (!rife_cadence_origin_from_presentation(
+                p->last_pts, target_fps, &p->rife_cadence_origin_pts)) {
+            rife_log_wait_reason(p, RIFE_WAIT_CADENCE_MISS, mix->num_frames);
+            return false;
+        }
+        p->rife_cadence_origin_valid = true;
+    }
+    int64_t cadence_index = 0;
+    if (!rife_cadence_grid_index(p->rife_cadence_origin_pts, p->last_pts,
+                                 target_fps, p->rife_cadence_output_valid,
+                                 p->rife_last_cadence_index, &cadence_index)) {
+        rife_log_wait_reason(p, RIFE_WAIT_CADENCE_MISS, mix->num_frames);
+        return false;
+    }
+    // Compute motion for the timestamp mpv will actually present, not the
+    // nearest cadence-grid timestamp (which can be slightly offset).
+    float timestep = (float) ((p->last_pts - before_pts) / source_duration);
+    p->rife_diag_timestep = timestep;
+    if (!isfinite(timestep) || timestep <= 0.f || timestep >= 1.f) {
+        int reason = RIFE_WAIT_INVALID_FRACTION;
+        if ((timestep >= -1e-6f && timestep <= 1e-6f) ||
+            (timestep >= 1.f - 1e-6f && timestep <= 1.f + 1e-6f))
+            reason = RIFE_WAIT_SOURCE_BOUNDARY;
+        rife_log_wait_reason(p, reason, mix->num_frames);
+        return false;
+    }
+
+    int width = 0, height = 0;
+    if (!rife_vfi_process_dimensions(mpi0->params.w, mpi0->params.h,
+            p->rife_root_opts->rife_max_dimension, target_fps,
+            &width, &height)) {
+        MP_WARN(p, "RIFE_DIAGNOSTIC event=resident_error reason=invalid_processing_dimensions source=%dx%d\n",
+                mpi0->params.w, mpi0->params.h);
+        rife_log_wait_reason(p, RIFE_WAIT_OUTPUT_RING, mix->num_frames);
+        return false;
+    }
+    if (!rife_init_output_ring(p, width, height)) {
+        MP_WARN(p, "RIFE_DIAGNOSTIC event=resident_error reason=output_ring_initialization_failed width=%d height=%d\n",
+                width, height);
+        rife_log_wait_reason(p, RIFE_WAIT_OUTPUT_RING, mix->num_frames);
+        return false;
+    }
+
+    int index = p->rife_output_cursor++ % MP_ARRAY_SIZE(p->rife_outputs);
+    struct rife_output_slot *slot = &p->rife_outputs[index];
+    if (slot->sampled) {
+        GL *gl = ra_gl_get(p->ra_ctx->ra);
+        if (!gl || !gl->Finish) {
+            rife_log_wait_reason(p, RIFE_WAIT_SLOT_SYNC, mix->num_frames);
+            return false;
+        }
+        // Conservative cross-API reuse: wait until the GLES compositor has
+        // stopped sampling this ring slot before NCNN reacquires it.
+        gl->Finish();
+        slot->sampled = false;
+    }
+
+    RifeVfiGpuFrame *synthesized = NULL;
