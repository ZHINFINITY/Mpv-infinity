+int bd_register_read_origin_proc(BLURAY *bd, void *handle, bd_read_origin_proc_f proc)
+{
+    int result = 0;
+    bd_mutex_lock(&bd->mutex);
+    if (!bd->st0.fp) {
+        bd->read_origin_handle = handle;
+        bd->read_origin_proc = proc;
+        result = 1;
+    }
+    bd_mutex_unlock(&bd->mutex);
+    return result;
+}
+
+void bd_retain_read_source(BD_READ_SOURCE *source)
+{
+    bd_mutex_lock(&source->mutex);
+    source->references++;
+    bd_mutex_unlock(&source->mutex);
+}
+
+void bd_release_read_source(BD_READ_SOURCE *source)
+{
+    unsigned references;
+    bd_mutex_lock(&source->mutex);
+    references = --source->references;
+    bd_mutex_unlock(&source->mutex);
+    if (!references) {
+        file_close(source->file);
+        bd_mutex_destroy(&source->mutex);
+        free(source);
+    }
+}
+
+int64_t bd_read_source(BLURAY *bd, BD_READ_SOURCE *source, uint64_t position,
+                       uint8_t *buffer, uint32_t size)
+{
+    int64_t result = -1;
+    if (source->owner != bd || position > INT64_MAX) {
+        return -1;
+    }
+    bd_mutex_lock(&bd->mutex);
+    int64_t saved_position = file_tell(source->file);
+    if (saved_position >= 0) {
+        if (file_seek(source->file, (int64_t)position, SEEK_SET) == (int64_t)position) {
+            result = source->file->read(source->file, buffer, size);
+        }
+        if (file_seek(source->file, saved_position, SEEK_SET) != saved_position) {
+            result = -1;
+        }
+    }
+    bd_mutex_unlock(&bd->mutex);
+    return result;
+}
